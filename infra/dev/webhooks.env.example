# Copie ce fichier en `webhooks.env` (ignoré par git) et colle les URL de webhook, une par salon.
# Ce sont des SECRETS : quiconque a l'URL peut écrire dans le salon.
DISCORD_WEBHOOK_SECURITY_ALERTS=
DISCORD_WEBHOOK_SECURITY_DIGEST=
DISCORD_WEBHOOK_PROJECTS_DIGEST=
DISCORD_WEBHOOK_SYSTEM=
NOTION_API_KEY=
NOTION_SECURITY_PAGE_ID=411e0621-1f6f-8198-8984-e8df265e2b2d

# Veille (module watch). Les clés sont des SECRETS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WATCH_MAX_ANALYSES_PER_RUN=30
# Boutons 👍/👎 : jeton du bot et clé publique de l'application Discord
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
# Un webhook par thème : DISCORD_WEBHOOK_WATCH_<SLUG> (ex. thème « ia » -> DISCORD_WEBHOOK_WATCH_IA)
DISCORD_WEBHOOK_WATCH_IA=
