# PostgreSQL
POSTGRES_DB=vigil
POSTGRES_USER=vigil_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://vigil_user:change_me@postgres:5432/vigil

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM - Google Gemini
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# n8n
N8N_USER=admin
N8N_PASSWORD=change_me
N8N_WEBHOOK_URL=https://your-domain.com/

# FastAPI
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
DISCORD_PUBLIC_KEY=your_discord_app_public_key

# Streamlit -> backend URL
API_URL=http://backend:8000/api

# Digest schedule (UTC)
DIGEST_HOUR=7
DIGEST_MINUTE=0

# Webhooks Discord, UN PAR SALON (SECRETS : quiconque a une URL peut poster dans le salon). DISCORD_WEBHOOK_<NOM> -> salon "<nom>"
DISCORD_WEBHOOK_SECURITY_ALERTS=
DISCORD_WEBHOOK_SECURITY_DIGEST=
DISCORD_WEBHOOK_PROJECTS_DIGEST=
DISCORD_WEBHOOK_SYSTEM=
# Signal de vie vers un service externe (healthchecks.io, Uptime Kuma...). SECRET. Optionnel mais recommandé.
VIGIL_HEARTBEAT_URL=

# Notion : jeton d integration (SECRET) et page « Tableau de bord sécurité » synchronisée par le module security
NOTION_API_KEY=
NOTION_SECURITY_PAGE_ID=411e0621-1f6f-8198-8984-e8df265e2b2d

# Audit du VPS (lecture seule, clé SSH restreinte à un script) : voir infra/audit/README.md
VPS_AUDIT_HOST=
VPS_AUDIT_USER=vigil-audit
VPS_AUDIT_PORT=22
VPS_AUDIT_SSH_KEY=
VPS_AUDIT_KNOWN_HOSTS=
VPS_AUDIT_TARGET=
VPS_AUDIT_PUBLIC_PORTS=22,80,443

# Veille (module watch). Les clés sont des SECRETS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WATCH_MAX_ANALYSES_PER_RUN=30
# Boutons 👍/👎 : jeton du bot et clé publique de l'application Discord
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
# Un webhook par thème : DISCORD_WEBHOOK_WATCH_<SLUG> (ex. thème « ia » -> DISCORD_WEBHOOK_WATCH_IA)
DISCORD_WEBHOOK_WATCH_IA=
