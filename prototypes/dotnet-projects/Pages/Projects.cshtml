@page "/projects"
@model DotnetProjects.Pages.ProjectsModel
<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><title>Projets suivis</title></head>
<body>
  <h1>Projets suivis (@Model.Repos.Count)</h1>
  <form method="post" asp-page-handler="Sync"><button>Synchroniser</button></form>
  <table>
    <tr><th>Repo</th><th>Langage</th><th>Issues</th><th>Dernier push</th><th>Verdict</th></tr>
    @foreach (var r in Model.Repos)
    {
      <tr>
        <td>@r.FullName</td><td>@r.Language</td><td>@r.OpenIssues</td>
        <td>@r.PushedAt?.ToString("dd/MM/yyyy")</td>
        <td>@DotnetProjects.Services.ProjectsService.ComputeVerdict(r)</td>
      </tr>
    }
  </table>
</body>
</html>
