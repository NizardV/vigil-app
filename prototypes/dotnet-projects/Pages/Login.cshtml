@page "/login"
@model DotnetProjects.Pages.LoginModel
<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><title>Connexion</title></head>
<body>
  <h1>Connexion</h1>
  <form method="post">
    <input asp-for="UserName" placeholder="Utilisateur" />
    <input asp-for="Password" type="password" placeholder="Mot de passe" />
    <button>Entrer</button>
  </form>
</body>
</html>
